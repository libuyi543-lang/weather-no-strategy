{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "cycles"],
  "properties": {
    "generatedAt": { "type": "string" },
    "cycles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId", "city", "metarObservationTimeUtc", "stateAssessment",
          "modelRealityGap", "remainingHeatingAssessment", "marketConsensusAssessment",
          "weatherProcessAssessment", "modelCorrectionAssessment", "processConfidence",
          "marketDecisionMode",
          "futureScenarios", "settlementDistribution", "temperatureThesis",
          "uncertaintyAssessment", "actions", "nextReviewReason"
        ],
        "properties": {
          "eventId": { "type": "string" },
          "city": { "type": "string" },
          "metarObservationTimeUtc": { "type": "string" },
          "stateAssessment": { "type": "string" },
          "modelRealityGap": { "type": "string" },
          "remainingHeatingAssessment": { "type": "string" },
          "marketConsensusAssessment": { "type": "string" },
          "weatherProcessAssessment": { "type": "string" },
          "modelCorrectionAssessment": { "type": "string" },
          "processConfidence": { "type": "string", "enum": ["low", "moderate", "high"] },
          "marketDecisionMode": {
            "type": "string",
            "enum": ["NO_RESEARCH", "AUTONOMOUS", "FOLLOW", "WATCH", "FADE", "NO_EDGE"]
          },
          "futureScenarios": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "plausibility", "weatherEvolution", "peakLowC", "peakHighC", "supportingEvidence", "invalidationSignal"],
              "properties": {
                "name": { "type": "string" },
                "plausibility": { "type": "string", "enum": ["primary", "plausible", "tail"] },
                "weatherEvolution": { "type": "string" },
                "peakLowC": { "type": "number" },
                "peakHighC": { "type": "number" },
                "supportingEvidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "invalidationSignal": { "type": "string" }
              }
            }
          },
          "settlementDistribution": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["outcomeRange", "rank", "classification", "probabilityBand", "reason"],
              "properties": {
                "outcomeRange": { "type": "string" },
                "rank": { "type": "integer", "minimum": 1 },
                "classification": {
                  "type": "string",
                  "enum": ["clear_leader", "contender", "plausible", "highly_unlikely", "excluded"]
                },
                "probabilityBand": {
                  "type": "string",
                  "enum": ["lt_5", "5_15", "15_30", "30_50", "gt_50"]
                },
                "reason": { "type": "string" }
              }
            }
          },
          "temperatureThesis": { "type": "string" },
          "uncertaintyAssessment": { "type": "string" },
          "nextReviewReason": { "type": "string" },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action", "entryType", "marketId", "outcomeSide", "shares", "outcomeAssessment",
                "probabilityBand", "priceAssessment", "priceRiskAssessment", "thesis",
                "evidence", "keyRisk", "invalidationCondition", "marketImpliedProbability",
                "consensusPosition", "evidenceStrength", "whyMarketMayBeRight",
                "whyMarketMayBeWrong", "disagreementEvidence", "newInformationTypes",
                "exactBucketRiskAssessment", "upperBucketRisk", "heatingProcessStatus",
                "newEvidenceSincePrior"
              ],
              "properties": {
                "action": { "type": "string", "enum": ["observe", "buy", "sell", "hold"] },
                "entryType": {
                  "type": "string",
                  "enum": ["NO_OVERSHOOT", "NO_CEILING", "NO_MARKET_TAIL_REJECTION", "AI_DISCRETION", "YES_CONVERGENCE", "NO_EXCLUSION", "NO_LEADER_OVERSHOOT", "YES_LADDER_EXPERIMENT", "POSITION_MANAGEMENT", "NONE"]
                },
                "sizingTier": {
                  "type": "string",
                  "enum": ["BASE", "STRONG", "NOT_APPLICABLE"]
                },
                "marketId": { "type": ["string", "null"] },
                "outcomeSide": { "type": ["string", "null"], "enum": ["YES", "NO", null] },
                "shares": { "type": ["number", "null"], "minimum": 0 },
                "outcomeAssessment": {
                  "type": "string",
                  "enum": ["clear_leader", "contender", "plausible", "highly_unlikely", "excluded", "not_applicable"]
                },
                "probabilityBand": {
                  "type": ["string", "null"],
                  "enum": ["lt_5", "5_15", "15_30", "30_50", "gt_50", null]
                },
                "priceAssessment": {
                  "type": "string",
                  "enum": ["favorable", "marginal", "unfavorable", "not_applicable"]
                },
                "priceRiskAssessment": { "type": "string" },
                "marketImpliedProbability": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
                "consensusPosition": { "type": "string", "enum": ["with_consensus", "against_consensus", "unclear"] },
                "evidenceStrength": { "type": "string", "enum": ["weak", "moderate", "strong"] },
                "whyMarketMayBeRight": { "type": "string" },
                "whyMarketMayBeWrong": { "type": "string" },
                "disagreementEvidence": { "type": "array", "items": { "type": "string" } },
                "newInformationTypes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["metar_model_divergence", "weather_regime_change", "forecast_revision", "market_lag", "station_mechanism", "orderbook_dislocation"]
                  }
                },
                "exactBucketRiskAssessment": { "type": "string" },
                "upperBucketRisk": { "type": "string", "enum": ["low", "moderate", "high", "unknown"] },
                "heatingProcessStatus": {
                  "type": "string",
                  "enum": ["active", "capping", "ended", "unclear"]
                },
                "newEvidenceSincePrior": { "type": "array", "items": { "type": "string" } },
                "thesis": { "type": "string" },
                "evidence": { "type": "array", "items": { "type": "string" } },
                "keyRisk": { "type": "string" },
                "invalidationCondition": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
