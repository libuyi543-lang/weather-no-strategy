{
  "enabled": true,
  "paperOnly": true,
  "strategyName": "weather_edge_paper_v1",
  "databasePath": "data/weather_market_monitor.sqlite3",
  "logPath": "logs/weather_edge_agent.log",
  "allowedCities": ["Shanghai", "Beijing", "Guangzhou", "Qingdao", "Wuhan", "Chongqing", "Chengdu"],

  "aiRuntime": "hermes",
  "hermesProfile": "weathertrader",
  "hermesBinary": "~/.local/bin/hermes",
  "hermesHome": "~/.hermes/profiles/weathertrader",
  "hermesProvider": "deepseek",
  "hermesModel": "deepseek-v4-flash",
  "hermesReasoningEffort": "medium",
  "hermesBaseUrl": "https://api.deepseek.com/v1",
  "hermesBaseUrlEnvVar": "DEEPSEEK_BASE_URL",
  "hermesApiKeyEnvVar": "DEEPSEEK_API_KEY",
  "hermesApiKeyFile": "~/.config/weather-market-monitor/deepseek_weather.key",
  "aiTimeoutSeconds": 300,
  "aiMalformedResponseRetries": 1,
  "aiCircuitBreakMinutes": 15,

  "initialCashUsdc": 100,
  "minCashReserveUsdc": 10,
  "maxOpenNotionalPerCity": 40,
  "maxOpenNotionalTotal": 90,
  "maxSharesPerOrder": 100,
  "maxOrdersPerDecision": 1,
  "fractionalKelly": 0.15,
  "confidenceFloor": 0.25,
  "executionShrinkEarly": 0.65,
  "executionShrinkLate": 0.50,
  "executionShrinkSettlement": 0.35,

  "feeRate": 0.05,
  "maxAllInCostPerShare": 0.92,
  "reviewIntervalMinutes": 5,
  "reviewStartLocalMinutes": 420,
  "analysisEndLocalMinutes": 1200,
  "entryCutoffLocalMinutes": 1080,
  "minDecisionIntervalMinutes": 30,
  "heartbeatReviewMinutes": 120,
  "marketMoveTrigger": 0.04,
  "weatherMoveTriggerC": 0.5,
  "maxMarketDataAgeMinutes": 20,
  "timezone": "Asia/Shanghai",

  "marketBaselineBrier": 0.239,
  "minEdge": 0.05,
  "feedbackAiEnabled": true,
  "feedbackAiTimeoutSeconds": 180,
  "maxFeedbackPerRun": 1,
  "lessonsPerCity": 8,
  "logMaxBytes": 5242880,
  "logBackupCount": 2
}
