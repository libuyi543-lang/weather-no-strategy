{
  "databasePath": "data/weather_market_monitor.sqlite3",
  "outputDir": "data/ai_no_backtests",
  "allowedCities": [
    "Shanghai",
    "Beijing",
    "Guangzhou",
    "Qingdao",
    "Wuhan",
    "Chongqing",
    "Chengdu"
  ],
  "lookbackResolvedDates": 3,
  "initialCashUsdc": 20.0,
  "stakeUsdc": 3.0,
  "weatherTakerFeeRate": 0.05,
  "liveMinimumShares": 5.0,
  "firstReviewLocalMinutes": 420,
  "lastReviewLocalMinutes": 1140,
  "defaultNextReviewMinutes": 60,
  "maxReviewsPerDay": 8,
  "marketSnapshotMaxAgeMinutes": 20,
  "maxMetarRowsPerCity": 24,
  "maxForecastRevisionsPerModel": 2,
  "hermesProfile": "weathertrader",
  "hermesBinary": "~/.local/bin/hermes",
  "hermesCredentialSourceHome": "~/.hermes/profiles/weathertrader",
  "hermesHome": "~/.hermes/profiles/weatherbacktest",
  "hermesToolsets": "profile",
  "hermesProvider": "deepseek",
  "hermesModel": "deepseek-v4-flash",
  "hermesReasoningEffort": "low",
  "aiTimeoutSeconds": 180,
  "aiMalformedResponseRetries": 1
}
