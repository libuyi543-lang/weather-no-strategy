  "required": ["assessment", "mistakes", "lesson"],
  "properties": {
    "assessment": {"type": "string", "minLength": 1},
    "mistakes": {"type": "array", "items": {"type": "string"}},
    "lesson": {"type": ["string", "null"]}
  }
}
