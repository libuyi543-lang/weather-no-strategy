{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "decisions"],
  "properties": {
    "generatedAt": { "type": "string" },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId", "action", "selectedMarketId", "noWinProbability",
          "confidenceLow", "confidenceHigh", "weatherThesis", "modelEvidence",
          "keyRisk", "resolutionRisk", "rejectionReason"
        ],
        "properties": {
          "eventId": { "type": "string" },
          "action": { "type": "string", "enum": ["trade", "no_trade"] },
          "selectedMarketId": { "type": ["string", "null"] },
          "noWinProbability": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "confidenceLow": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "confidenceHigh": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "weatherThesis": { "type": "string" },
          "modelEvidence": { "type": "array", "items": { "type": "string" } },
          "keyRisk": { "type": "string" },
          "resolutionRisk": { "type": "string" },
          "rejectionReason": { "type": ["string", "null"] }
        }
      }
    }
  }
}
